# -*- Conf -*-
[user]
  name = Matt Davis
  email = maroda@gmail.com
  # Added for 1Password support
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXZC/yBzFxk9fPHmGN0SiALv8PAWzgCMvsLcuu5oYzS
[github]
  user = maroda

# Added for Ruby Console support
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/

# Added for 1Password support
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true

[core]
  editor = vim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[rerere]
  enabled = 1
  autoupdate = 1
[diff]
  tool = icdiff
[difftool]
  prompt = false
[difftool "icdiff"]
  cmd = /usr/local/bin/icdiff --line-numbers $LOCAL $REMOTE

[delta]
  features = line-numbers decorations
  line-numbers = true
[delta "decorations"]
  minus-style = red bold normal
  plus-style = green bold normal
  minus-emph-style = white bold red
  minus-non-emph-style = red bold normal
  plus-emph-style = white bold green
  plus-non-emph-style = green bold normal
  file-style = yellow bold none
  file-decoration-style = yellow box
  hunk-header-style = magenta bold
  hunk-header-decoration-style = magenta box
  minus-empty-line-marker-style = normal normal
  plus-empty-line-marker-style = normal normal
  line-numbers-right-format = "{np:^4}│ "

[alias]
  st = status -sb
  ci = commit
  co = checkout
  graph = log --graph --oneline --decorate=short --branches='*'
  br = branch
  df = icdiff
  sh = show --color-words='[^[:space:]]'
  lg = log -p
[format]
  pretty = '%C(yellow)%h%Creset %C(magenta)%cd%Creset %d %s'
[push]
    # default = simple

[color]
  branch = auto
  diff = auto
  status = auto
  showbranch = auto
  ui = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan
